PORT=3000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT_URL=http://localhost:4566
S3_QUARANTINE_BUCKET=doc-ai-local-quarantine
DATABASE_URL=postgresql://doc_ai:doc-ai-local-password@localhost:5432/doc_ai
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=doc-ai-local-document-jobs
SQS_QUEUE_URL=http://localhost:4566/000000000000/doc-ai-local-document-jobs
SQS_DLQ_URL=http://localhost:4566/000000000000/doc-ai-local-document-jobs-dlq
WORKER_POLL_WAIT_SECONDS=20
WORKER_RECEIVE_MAX=1
WORKER_VISIBILITY_TIMEOUT_SECONDS=120
WORKER_LEASE_MS=120000
WORKER_HEARTBEAT_MS=30000
WORKER_RETRY_DELAY_SECONDS=1
WORKER_RETRY_DELAY_MAX_SECONDS=300
