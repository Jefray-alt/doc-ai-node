PORT=3000

# Host-run backend and browser must reach the same loopback Moto endpoint.
STORAGE_MODE=moto
AWS_REGION=us-east-1
S3_STAGING_BUCKET=pdf-staging
S3_ENDPOINT=http://localhost:5000

# AWS deployment: STORAGE_MODE=aws, set AWS_REGION and S3_STAGING_BUCKET,
# and remove S3_ENDPOINT entirely. Use the deployment role's credentials.
# Never put storage credentials in frontend environment variables.
